<launch>
  <!-- Argumento para facilitar a troca do modelo -->
  <arg name="model_file" default="$(find asio)/urdf/asio.urdf"/>

  <!-- Processa o URDF -->
  <param name="robot_description" textfile="$(arg model_file)" />

  <!-- Publica os estados das juntas -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <!-- Nó opcional para controlar juntas -->
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />

  <!-- Lança o Gazebo com o mundo padrão (você pode substituir por um .world seu) -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch" />

  <!-- Spawna o modelo no Gazebo -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
        args="-param robot_description -urdf -model asio -x 0 -y 0 -z 0.1"
        output="screen" />
</launch>
